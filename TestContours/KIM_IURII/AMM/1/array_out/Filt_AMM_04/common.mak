#APPLICATION_C        = $(BIN_DIR)$(SL)testthreshold$(HSUFFIX)$(EXE) \
#                       $(BIN_DIR)$(SL)testprint$(HSUFFIX)$(EXE) \
#                       $(BIN_DIR)$(SL)testregionfeatures$(HSUFFIX)$(EXE) \
#                       $(BIN_DIR)$(SL)testfilter$(HSUFFIX)$(EXE)

#APPLICATION_CPP      = $(BIN_DIR)$(SL)testthresholdcpp$(HSUFFIX)$(EXE) \
#                       $(BIN_DIR)$(SL)testregionfeaturescpp$(HSUFFIX)$(EXE) \
#                       $(BIN_DIR)$(SL)testfiltercpp$(HSUFFIX)$(EXE)

APPLICATION_DOTNET_NAME = testthresholddotnet
APPLICATION_DOTNET   = $(BIN_DIR_DOTNET)$(SL)$(APPLICATION_DOTNET_NAME)$(HSUFFIX)_$(HALCONARCH).exe
